# Cartix Environment Configuration
# Copy this file to `.env` and replace the placeholder values.
# NEVER commit the real `.env` file or any credentials.

# -------------------------------------------------------------------
# WooCommerce
# -------------------------------------------------------------------

# Base URL of the merchant's WooCommerce store.
# Example: https://store.example.com
WOOCOMMERCE_URL=

# WooCommerce REST API credentials.
# Use a READ-ONLY API key for the assessment.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# -------------------------------------------------------------------
# Cartix MCP Server
# -------------------------------------------------------------------

# Port used by the local MCP server.
PORT=3000

# Runtime environment.
NODE_ENV=development

# MCP server transport: stdio, streamable-http, or sse.
MCP_TRANSPORT=stdio

# -------------------------------------------------------------------
# Reliability & Rate Limiting
# -------------------------------------------------------------------

# Maximum number of upstream retries for retryable failures.
MAX_RETRIES=3

# Base delay in milliseconds for exponential backoff with jitter.
RETRY_BASE_DELAY_MS=500

# Upstream request timeout in milliseconds.
REQUEST_TIMEOUT_MS=10000

# Maximum number of records returned by a single tool call (hard ceiling: 100).
MAX_PAGE_SIZE=100

# -------------------------------------------------------------------
# Logging & Observability
# -------------------------------------------------------------------

# Logging level: debug, info, warn, error.
LOG_LEVEL=info

# -------------------------------------------------------------------
# Security Notes
# -------------------------------------------------------------------

# 1. Do not place real credentials in this file.
# 2. Keep `.env` in `.gitignore`.
# 3. Never pass WooCommerce credentials to MCP tool inputs.
# 4. Never log consumer keys/secrets or Authorization headers.