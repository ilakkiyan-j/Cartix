# ===================================================================
# Cartix — WooCommerce Agent Connector Environment Configuration
# ===================================================================
# Copy this file to `.env` in your local Cartix directory.
# NEVER commit your `.env` file or expose real credentials.

# -------------------------------------------------------------------
# WooCommerce Store Connection (Strictly Read-Only)
# -------------------------------------------------------------------
# Base HTTPS URL of your WooCommerce store (trailing slash is trimmed automatically).
# Example: https://store.example.com
WOOCOMMERCE_URL=https://your-store.example.com

# WooCommerce REST API credentials.
# IMPORTANT: Generate keys with 'Read' permissions ONLY in WP Admin.
WOOCOMMERCE_CONSUMER_KEY=ck_your_read_only_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_read_only_consumer_secret

# -------------------------------------------------------------------
# MCP Server Configuration
# -------------------------------------------------------------------
# Server transport: stdio (verified and recommended for local AI agents).
MCP_TRANSPORT=stdio

# Port (only used when running in HTTP mode; default: 3000).
PORT=3000

# Runtime environment (development, production, or test).
NODE_ENV=production

# -------------------------------------------------------------------
# Reliability & Rate Limiting
# -------------------------------------------------------------------
# Maximum retry attempts for transient upstream failures (429, 5xx, timeouts).
MAX_RETRIES=3

# Initial base delay in milliseconds for exponential backoff with jitter.
RETRY_BASE_DELAY_MS=500

# Upstream request timeout in milliseconds.
REQUEST_TIMEOUT_MS=10000

# Hard limit ceiling for records per tool call (1-100).
MAX_PAGE_SIZE=100

# -------------------------------------------------------------------
# Logging & Observability
# -------------------------------------------------------------------
# Logging verbosity: debug, info, warn, error.
# TIP: Use 'error' in stdio mode to avoid stdout log noise.
LOG_LEVEL=error
